[Unit]
Description=The Brief — daily Bangladesh economy digest (V6 publish to Supabase)
Documentation=https://github.com/clauding-lab/the-brief
After=network-online.target
Wants=network-online.target
# Any hard failure of this unit (non-zero exit incl. the sub-editor's exit 4,
# TimeoutStartSec SIGTERM, OOM-kill) fires a Discord ping via the templated alert
# unit — %n expands to "brief.service". See deploy/brief-alert@.service.
OnFailure=brief-alert@%n.service

[Service]
Type=oneshot
User=adnan
Group=adnan
WorkingDirectory=/home/adnan/the-brief
EnvironmentFile=/etc/brief.env

# Self-deploy before every fire (kills AGENTS.md landmine 21 — merging to main
# deployed nothing; the box ran whatever was checked out).
#
# Three ExecStartPre steps, in order:
#   1. GUARD (fail-closed, NO '-' prefix): brief_guard.sh refuses any checkout that
#      is not `main` (feature branch / detached HEAD) — `git pull origin main` merges
#      into WHATEVER is checked out, so without this a stray checkout would silently
#      publish untested code. A held publish beats publishing wrong code to bankers:
#      readers keep yesterday's complete brief (PR #125 semantics) and the failure
#      fires the OnFailure Discord alert above.
#   2. PULL (best-effort, '-' prefix): if GitHub is unreachable or the pull can't
#      fast-forward, the publish still runs on the current checkout — a stale brief
#      beats no brief. --ff-only never rewrites or merges local state. timeout 120
#      caps a network-blackholed pull so it can't eat the 90-min start budget
#      (TimeoutStartSec covers ExecStartPre too).
#   3. GUARD again: re-verifies main and logs the POST-pull branch + short HEAD, so
#      the journal records exactly which commit this fire ran.
# Safe as a single service (unlike econdelta's 16-unit cascade). Repo writes are
# allowed via ReadWritePaths.
ExecStartPre=/home/adnan/the-brief/deploy/brief_guard.sh
ExecStartPre=-/usr/bin/timeout 120 /usr/bin/git -C /home/adnan/the-brief pull --ff-only origin main
ExecStartPre=/home/adnan/the-brief/deploy/brief_guard.sh

ExecStart=/home/adnan/the-brief/.venv/bin/python -m brief.cli run --publish

# Resource limits — V6 publish does 2 Claude calls (editor + subeditor),
# each up to 64K tokens; memory stays well under 600M in practice.
MemoryMax=600M
MemoryHigh=500M
CPUQuota=80%
TasksMax=128

# Hardening
PrivateTmp=true
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/adnan/the-brief /home/adnan/.claude

# Timeouts — pipeline target ~15m. Hard cap matches the editor_v6 retry budget
# in brief/pipeline_v6.py (`_call_with_retries`: 3 attempts × 1800s + delays ≈ 90m).
# Shorten only if the retry budget is also shortened, otherwise the unit kills
# the python mid-retry and a transient Anthropic blip becomes a missed issue.
TimeoutStartSec=90min

# Logging — systemd journal + append to file
StandardOutput=append:/home/adnan/the-brief/logs/brief-systemd.log
StandardError=append:/home/adnan/the-brief/logs/brief-systemd.log
SyslogIdentifier=brief

[Install]
WantedBy=multi-user.target
