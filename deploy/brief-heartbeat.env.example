# /etc/brief-heartbeat.env — chmod 640 root:adnan-local (ExonVPS)
# Config for deploy/heartbeat.py, the off-box fleet heartbeat (07:30 BDT cron).
# Copy to /etc/brief-heartbeat.env and fill in real values.

# Supabase project (same project The Brief + EconDelta write to).
SUPABASE_URL=https://ssbliukchgibjcjohibi.supabase.co

# ANON key only — both checked tables (briefs, run_logs) are anon-readable.
# Never put the service-role key on this box; the heartbeat only reads.
SUPABASE_ANON_KEY=REDACTED

# Discord webhook for fleet alerts — same channel/webhook as the Hetzner alert
# kit's DISCORD_ALERT_WEBHOOK_URL (deploy/brief.env.example), so all ops alerts
# land in one place.
DISCORD_ALERT_WEBHOOK_URL=REDACTED
