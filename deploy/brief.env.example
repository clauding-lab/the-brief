# /etc/brief.env — chmod 640 root:adnan
# Copy to /etc/brief.env and fill in real values before `systemctl start brief.service`.

# --- Claude Max CLI -----------------------------------------------------------
# Pin absolute path so systemd (which does not source ~/.bashrc) finds the
# 1M-context 2.1.119 build at /home/adnan/.npm-global/bin/claude, not the
# older root-installed /usr/bin/claude.
CLAUDE_BINARY=/home/adnan/.npm-global/bin/claude

# --- EconDelta data source ----------------------------------------------------
ECONDELTA_DATA=/home/adnan/econdelta/data/latest.json

# --- Supabase (history read/write) -------------------------------------------
SUPABASE_URL=https://ssbliukchgibjcjohibi.supabase.co
SUPABASE_SERVICE_ROLE_KEY=REDACTED
SUPABASE_SERVICE_KEY=REDACTED

# --- Brevo (release email + preview email; existing) -------------------------
# BREVO_API_KEY and FROM_EMAIL already drive brief/notifier.py's subscriber email.
# The preview-notify path below reuses both.
BREVO_API_KEY=REDACTED
FROM_EMAIL=adnan@thebrief.clauding-lab.com

# --- Preview-ready pings (brief/preview_notify.py) ---------------------------
# Fires when `brief.cli run --publish --dry-run --write-fixture <path> --preview-notify`
# completes. Each channel is independent; either can be absent and the other still fires.
#
# 1. Discord webhook — create one in Discord Server Settings → Integrations →
#    Webhooks → New Webhook in the channel you want previews to land. Paste the
#    full webhook URL here.
DISCORD_PREVIEW_WEBHOOK_URL=
# 2. Email recipient for preview drafts. Single address, NOT the subscriber list.
PREVIEW_EMAIL_RECIPIENT=adnan.rshd@gmail.com

