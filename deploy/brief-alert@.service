# Discord failure alert — templated unit fired via OnFailure=brief-alert@%n.service
# from brief.service (and any future brief-* unit). %i carries the FAILED unit's name,
# so one alert unit serves every publisher-side service.
#
# Install: handled by deploy/install.sh (copies to /etc/systemd/system/).
# Requires DISCORD_ALERT_WEBHOOK_URL (or DISCORD_PREVIEW_WEBHOOK_URL as fallback)
# in /etc/brief.env — see deploy/brief.env.example.

[Unit]
Description=Discord failure alert for %i

[Service]
Type=oneshot
User=adnan
Group=adnan
EnvironmentFile=/etc/brief.env
ExecStart=/home/adnan/the-brief/deploy/brief_alert.sh %i

# The alert itself must never hang the failure path.
TimeoutStartSec=60
