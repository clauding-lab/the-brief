[Unit]
Description=Run The Brief daily at 08:00 BDT (02:00 UTC)

[Timer]
# Moved 06:30 -> 08:00 BDT so the fire lands AFTER EconDelta's aggregate, not
# ~17h behind it. See AGENTS.md landmine 21 for the ordering this depends on.
OnCalendar=Mon..Sun 02:00:00 UTC
Persistent=true
Unit=brief.service

[Install]
WantedBy=timers.target
