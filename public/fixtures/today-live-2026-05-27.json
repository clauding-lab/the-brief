d": true, "headline": "Bangladesh, IMF agree on new realistic three-year reform programme", "held_from": null, "source_url": "https://www.tbsnews.net/economy/govt-officially-scraps-al-era-imf-loan-deal-seeks-fresh-5b-package-1448201", "published_at": "2026-05-27T00:30:01.918489+00:00"}, {"id": "387ea0b8-2408-4a14-9243-7fe4b56390a6", "ord": 2, "tone": "bull", "detail": "Programme-level commitment — project depth but not a recurrent-gap fix.", "source": "TBS", "changed": false, "headline": "ADB president meets PM Tarique, says it intends to provide $5b over five years", "held_from": null, "source_url": "https://www.tbsnews.net/economy/adb-president-meets-pm-announces-5b-bangladeshs-development-1448261", "published_at": "2026-05-27T00:30:01.918489+00:00"}], "slug": "fiscal", "tldr": "Borrowing exceeds target in 9 months; budget June 7 the next catalyst.", "notes": [], "title": "Fiscal", "series": [], "weight": 1, "metrics": [{"id": "64a3a1a6-90f4-4496-b58a-492d68d8aeb9", "ord": 0, "sub": "Crossed annual target in 9 months · crowds credit", "tone": "warn", "delta": null, "label": "Govt bank borrow YTD", "spark": null, "value": "BDT 0.92tn", "weight": 2, "changed": false, "delta_pct": null, "held_from": null, "next_print": null, "is_snapshot": false}, {"id": "ddf3da63-dcad-402e-bb42-03067ee86f19", "ord": 1, "sub": "Prior print · consecutive target misses", "tone": "warn", "delta": null, "label": "NBR collected YTD", "spark": null, "value": "BDT 2.88tn", "weight": 1, "changed": false, "delta_pct": null, "held_from": null, "next_print": null, "is_snapshot": false}], "verdict": "Bank borrowing beyond target — fiscal stress persists pre-budget.", "analysis": "Government bank borrowing at BDT 0.92tn — crossing the annual target in nine months confirms fiscal financing running ahead of plan. The IMF agreement on a new 3-year reform programme provides the external financing lifeline but introduces conditionality that constrains FY27 budget flexibility on both revenue and expenditure. ADB's upgraded $5B commitment over five years adds project-level depth but does not address the recurrent fiscal gap. The binding constraint: fiscal consolidation conditionality arrives while credit growth sits at 6.03% and NPL at 35.73% — the sovereign that must fund bank recapitalization is itself borrowing beyond plan. Budget June 7 is the decision point.", "brief_id": "bb0581b8-752f-4361-96c2-8a54b4718572", "freshness": "warming_up", "group_key": "policy", "banker_read": {"risk": ["Accelerating fiscal borrowing crowds private credit further", "IMF consolidation requirements during downturn create procyclical squeeze"], "watch": ["Budget June 7 — domestic borrowing and revenue targets", "IMF conditionality terms for fiscal consolidation"], "runway": null, "verdict": "Government bank borrowing crossed the annual target in nine months — fiscal financing running ahead of plan on prior print. IMF agreement provides external financing but introduces conditionality that constrains FY27 budget parameters. Budget June 7 is the next catalyst."}, "verdict_tone": "warn", "summary_pills": [{"key": "GOVT BORROW", "tone": "warn", "value": "BDT 0.92tn"}, {"key": "NBR YTD", "tone": "warn", "value": "BDT 2.88tn"}]}, {"id": "c4b80511-b082-4b2d-8cfa-7d3fe8461928", "ord": 9, "news": [{"id": "ce9343f8-1048-4334-81a2-2dd5058392ab", "ord": 0, "tone": "warn", "detail": "Demand destruction signals consumer price-sensitivity in energy.", "source": "DS", "changed": false, "headline": "LPG market slows as price hikes hit demand", "held_from": null, "source_url": "https://www.thedailystar.net/business/economy/news/lpg-market-slows-price-hikes-hit-demand-4184636", "published_at": "2026-05-27T00:30:01.719097+00:00"}], "slug": "macro", "tldr": "Inflation and credit unchanged from prior prints; rate-cut runway closed.", "notes": [], "title": "Macro & Inflation", "series": [], "weight": 1, "metrics": [{"id": "150e81cd-5f47-4cb9-8df1-57f7c451c63f", "ord": 0, "sub": "BBS print · unchanged", 